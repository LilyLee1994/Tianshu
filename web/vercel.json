{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-hostaway",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron-hostaway",
      "schedule": "10 17 * * *"
    },
    {
      "path": "/api/cron-hostaway",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/cron-hostaway",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron-cleanup-photos",
      "schedule": "30 18 * * *"
    }
  ],
  "functions": {
    "api/cron-hostaway.ts": {
      "maxDuration": 60
    },
    "api/statements.ts": {
      "maxDuration": 30
    },
    "api/hostaway-inventory.ts": {
      "maxDuration": 30
    },
    "api/cron-cleanup-photos.ts": {
      "maxDuration": 30
    }
  }
}